{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "ci",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "default", "configuration": "Debug" },
    { "name": "release", "configurePreset": "default", "configuration": "Release" },
    { "name": "ci", "configurePreset": "ci", "configuration": "Release" }
  ]
}
